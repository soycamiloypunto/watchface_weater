<?xml version="1.0" encoding="utf-8"?>
<!--
    Weather Land — Realistic AMOLED Edition (Wear OS Watch Face Format v2)
    Canvas: 450x450 circular | Fondo negro puro #000000 AMOLED.
    Clima nativo Wear OS [WEATHER.*] (cero configuración, sin OpenWeather API).

    Capas en orden Z (de atrás hacia adelante):
      1. Astros (Sol con corona volumétrica y llamaradas/ríos solares / Luna en 3 fases reales + estrellas alrededor)
      2. Rayos eléctricos (slide-down siempre desde debajo de cobertura continua de nubes de tormenta + flash)
      3. Nubes volumétricas pasando de izquierda a derecha en múltiples capas superpuestas
      4. Nieve lejana / Niebla descendente / Viento
      5. HUD (Batería, Hora, Fecha completa, Temperatura — todos configurables)
      6. SOBRE EL VIDRIO (ENCIMA DE LA HORA):
         - Lluvia realista en 2 planos sobre toda la pantalla
         - Gotas limpias resbalando por el cristal
         - Cristal empañado sutil que respira
         - Nieve cercana cayendo suavemente sin saltos
         - Niebla/humo rápido pasando por la parte baja
         - Destello/reflejo solar en el cristal (Lens Flare)
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <UserConfigurations>
        <BooleanConfiguration
            id="show_time"
            displayName="@string/config_show_time"
            screenReaderText="@string/config_show_time"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="show_date"
            displayName="@string/config_show_date"
            screenReaderText="@string/config_show_date"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="show_battery"
            displayName="@string/config_show_battery"
            screenReaderText="@string/config_show_battery"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="show_temperature"
            displayName="@string/config_show_temperature"
            screenReaderText="@string/config_show_temperature"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="show_glass_fog"
            displayName="@string/config_show_glass_fog"
            screenReaderText="@string/config_show_glass_fog"
            defaultValue="TRUE" />
    </UserConfigurations>

    <!-- Fondo NEGRO PURO AMOLED -->
    <Scene backgroundColor="#FF000000">

        <!-- =================================================================
             CAPAS DE FONDO (SE APAGAN EN MODO AMBIENT / AOD PARA AHORRAR OLED)
             ================================================================= -->
        <Group name="weather_background" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- 1. ASTROS: SOL REALISTA CON RAYOS LARGOS + RÍOS DE PLASMA / LUNA EN 3 FASES -->
            <Condition>
                <Expressions>
                    <Expression name="show_sun"><![CDATA[[WEATHER.IS_AVAILABLE] && [WEATHER.IS_DAY] && ([WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8 || [WEATHER.CONDITION] == 14)]]></Expression>
                    <Expression name="show_moon_waxing"><![CDATA[(!([WEATHER.IS_AVAILABLE]) || ![WEATHER.IS_DAY]) && ([WEATHER.CONDITION] == 0 || [WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 14) && (((([UTC_TIMESTAMP] - 1704974220000) / 86400000.0) % 29.530588) &lt; 11.0)]]></Expression>
                    <Expression name="show_moon_full"><![CDATA[(!([WEATHER.IS_AVAILABLE]) || ![WEATHER.IS_DAY]) && ([WEATHER.CONDITION] == 0 || [WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 14) && (((([UTC_TIMESTAMP] - 1704974220000) / 86400000.0) % 29.530588) &gt;= 11.0) && (((([UTC_TIMESTAMP] - 1704974220000) / 86400000.0) % 29.530588) &lt; 18.5)]]></Expression>
                    <Expression name="show_moon_waning"><![CDATA[(!([WEATHER.IS_AVAILABLE]) || ![WEATHER.IS_DAY]) && ([WEATHER.CONDITION] == 0 || [WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 14) && (((([UTC_TIMESTAMP] - 1704974220000) / 86400000.0) % 29.530588) &gt;= 18.5)]]></Expression>
                </Expressions>

                <!-- SOL REALISTA + RAYOS VOLUMÉTRICOS LARGOS + RÍOS DE PLASMA EN LA SUPERFICIE -->
                <Compare expression="show_sun">
                    <!-- Corona y rayos largos orgánicos girando suavemente -->
                    <PartImage x="-35" y="-100" width="520" height="520" pivotX="0.5" pivotY="0.5">
                        <Transform target="angle" value="([UTC_TIMESTAMP] / 220.0) % 360" />
                        <Transform target="alpha" value="190 + 55 * sin([UTC_TIMESTAMP] / 1400.0)" />
                        <Image resource="fx_sun_corona" />
                    </PartImage>
                    <!-- Ríos de plasma / prominencias solares capa A (levantándose en el borde) -->
                    <PartImage x="45" y="-20" width="360" height="360" pivotX="0.5" pivotY="0.5">
                        <Transform target="angle" value="([UTC_TIMESTAMP] / 260.0) % 360" />
                        <Transform target="scaleX" value="1.0 + 0.045 * sin([UTC_TIMESTAMP] / 1500.0)" />
                        <Transform target="scaleY" value="1.0 + 0.045 * sin([UTC_TIMESTAMP] / 1500.0)" />
                        <Transform target="alpha" value="160 + 80 * sin([UTC_TIMESTAMP] / 1300.0)" />
                        <Image resource="fx_sun_flares" />
                    </PartImage>
                    <!-- Ríos de plasma capa B (contra-rotación suave para movimiento orgánico vivo) -->
                    <PartImage x="45" y="-20" width="360" height="360" pivotX="0.5" pivotY="0.5">
                        <Transform target="angle" value="360 - (([UTC_TIMESTAMP] / 340.0) % 360)" />
                        <Transform target="scaleX" value="1.0 + 0.04 * cos([UTC_TIMESTAMP] / 1900.0)" />
                        <Transform target="scaleY" value="1.0 + 0.04 * cos([UTC_TIMESTAMP] / 1900.0)" />
                        <Transform target="alpha" value="135 + 75 * cos([UTC_TIMESTAMP] / 1700.0)" />
                        <Image resource="fx_sun_flares" />
                    </PartImage>
                    <!-- Disco solar realista -->
                    <PartImage x="65" y="0" width="320" height="320" pivotX="0.5" pivotY="0.5">
                        <Transform target="scaleX" value="1.0 + 0.02 * sin([UTC_TIMESTAMP] / 1400.0)" />
                        <Transform target="scaleY" value="1.0 + 0.02 * sin([UTC_TIMESTAMP] / 1400.0)" />
                        <Image resource="sol" />
                    </PartImage>
                </Compare>

                <!-- LUNA CUARTO CRECIENTE (estrellas en todo el cielo, nunca sobre la luna) -->
                <Compare expression="show_moon_waxing">
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * sin([UTC_TIMESTAMP] / 1300.0)" />
                        <Image resource="celestial_stars_a" />
                    </PartImage>
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * cos([UTC_TIMESTAMP] / 1700.0)" />
                        <Image resource="celestial_stars_b" />
                    </PartImage>
                    <PartImage x="85" y="10" width="280" height="280">
                        <Image resource="moon_waxing" />
                    </PartImage>
                </Compare>

                <!-- LUNA LLENA -->
                <Compare expression="show_moon_full">
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * sin([UTC_TIMESTAMP] / 1300.0)" />
                        <Image resource="celestial_stars_a" />
                    </PartImage>
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * cos([UTC_TIMESTAMP] / 1700.0)" />
                        <Image resource="celestial_stars_b" />
                    </PartImage>
                    <PartImage x="85" y="10" width="280" height="280">
                        <Image resource="moon_full" />
                    </PartImage>
                </Compare>

                <!-- LUNA CUARTO MENGUANTE -->
                <Compare expression="show_moon_waning">
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * sin([UTC_TIMESTAMP] / 1300.0)" />
                        <Image resource="celestial_stars_a" />
                    </PartImage>
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="110 + 115 * cos([UTC_TIMESTAMP] / 1700.0)" />
                        <Image resource="celestial_stars_b" />
                    </PartImage>
                    <PartImage x="85" y="10" width="280" height="280">
                        <Image resource="moon_waning" />
                    </PartImage>
                </Compare>
            </Condition>

            <!-- 2. RELÁMPAGOS EN SLIDE HACIA ABAJO + ILUMINACIÓN DE PANTALLA (TORMENTA)
                 Siempre salen desde debajo de la cobertura continua de 5 nubes oscuras. -->
            <Condition>
                <Expressions>
                    <Expression name="is_storm"><![CDATA[[WEATHER.IS_AVAILABLE] && [WEATHER.CONDITION] == 9]]></Expression>
                </Expressions>
                <Compare expression="is_storm">
                    <!-- Flash eléctrico ambiental sincronizado con los 3 impactos del ciclo de 12 s -->
                    <PartImage x="0" y="0" width="450" height="450">
                        <Transform target="alpha" value="(((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 0.35) || (((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt; 4.0) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 4.40)) || (((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt; 8.2) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 8.65))) ? 180 : 0" />
                        <Image resource="fx_storm_flash" />
                    </PartImage>

                    <!-- Rayo 1: Izquierda (0.0s - 0.42s, slide hacia abajo desde y=-130 hasta y=0) -->
                    <PartImage x="0" y="-130" width="450" height="450">
                        <Transform target="y" value="clamp(-130 + ((([UTC_TIMESTAMP] / 1000.0) % 12.0) * 900.0), -130, 0)" />
                        <Transform target="alpha" value="((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 0.18 || ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt; 0.24 &amp;&amp; (([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 0.42)) ? 255 : 0" />
                        <Image resource="lightning_left" />
                    </PartImage>

                    <!-- Rayo 2: Centro (4.0s - 4.45s, slide hacia abajo) -->
                    <PartImage x="0" y="-130" width="450" height="450">
                        <Transform target="y" value="clamp(-130 + (((([UTC_TIMESTAMP] / 1000.0) % 12.0) - 4.0) * 900.0), -130, 0)" />
                        <Transform target="alpha" value="((((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt;= 4.0) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 4.18)) || (((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt; 4.24) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 4.45))) ? 255 : 0" />
                        <Image resource="lightning_center" />
                    </PartImage>

                    <!-- Rayo 3: Doble Izquierda-Derecha (8.2s - 8.72s, slide hacia abajo protagonista) -->
                    <PartImage x="0" y="-130" width="450" height="450">
                        <Transform target="y" value="clamp(-130 + (((([UTC_TIMESTAMP] / 1000.0) % 12.0) - 8.2) * 900.0), -130, 0)" />
                        <Transform target="alpha" value="((((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt;= 8.2) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 8.40)) || (((([UTC_TIMESTAMP] / 1000.0) % 12.0) &gt; 8.48) &amp;&amp; ((([UTC_TIMESTAMP] / 1000.0) % 12.0) &lt; 8.72))) ? 255 : 0" />
                        <Image resource="lightning_double" />
                    </PartImage>
                </Compare>
            </Condition>

            <!-- 3. NUBES VOLUMÉTRICAS PASANDO DE IZQUIERDA A DERECHA (ANTEPUESTAS SEGÚN CLIMA) -->
            <Condition>
                <Expressions>
                    <Expression name="is_partly_cloudy"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 14 || [WEATHER.CONDITION] == 15)]]></Expression>
                    <Expression name="is_overcast"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 2 || [WEATHER.CONDITION] == 5 || [WEATHER.CONDITION] == 7 || [WEATHER.CONDITION] == 10 || [WEATHER.CONDITION] == 11)]]></Expression>
                    <Expression name="is_rainy_clouds"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 4 || [WEATHER.CONDITION] == 6 || [WEATHER.CONDITION] == 12)]]></Expression>
                    <Expression name="is_storm_clouds"><![CDATA[[WEATHER.IS_AVAILABLE] && [WEATHER.CONDITION] == 9]]></Expression>
                </Expressions>

                <!-- SEMINUBLADO: 4 nubes pasando continuamente una detrás de otra y superpuestas -->
                <Compare expression="is_partly_cloudy">
                    <PartImage x="-380" y="-25" width="380" height="380">
                        <Transform target="x" value="-380 + ((([UTC_TIMESTAMP] / 1000.0) * 13.0) % 860)" />
                        <Transform target="alpha" value="210" />
                        <Image resource="cloud_pair" />
                    </PartImage>
                    <PartImage x="-360" y="10" width="360" height="360">
                        <Transform target="x" value="-360 + (((([UTC_TIMESTAMP] / 1000.0) * 16.0) + 215) % 860)" />
                        <Image resource="cloud_day" />
                    </PartImage>
                    <PartImage x="-390" y="-5" width="390" height="390">
                        <Transform target="x" value="-390 + (((([UTC_TIMESTAMP] / 1000.0) * 14.5) + 430) % 860)" />
                        <Transform target="alpha" value="230" />
                        <Image resource="cloud_trio" />
                    </PartImage>
                    <PartImage x="-350" y="25" width="350" height="350">
                        <Transform target="x" value="-350 + (((([UTC_TIMESTAMP] / 1000.0) * 18.0) + 645) % 860)" />
                        <Transform target="alpha" value="220" />
                        <Image resource="cloud_day" />
                    </PartImage>
                </Compare>

                <!-- MUY NUBLADO / NIEVE: 6 capas densas mezclando nubes oscuras y blancas -->
                <Compare expression="is_overcast">
                    <PartImage x="-420" y="-55" width="420" height="420">
                        <Transform target="x" value="-420 + ((([UTC_TIMESTAMP] / 1000.0) * 9.0) % 900)" />
                        <Transform target="alpha" value="205" />
                        <Image resource="cloud_storm_pair" />
                    </PartImage>
                    <PartImage x="-400" y="-35" width="400" height="400">
                        <Transform target="x" value="-400 + (((([UTC_TIMESTAMP] / 1000.0) * 11.0) + 150) % 900)" />
                        <Transform target="alpha" value="215" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                    <PartImage x="-400" y="-20" width="400" height="400">
                        <Transform target="x" value="-400 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 300) % 900)" />
                        <Image resource="cloud_trio" />
                    </PartImage>
                    <PartImage x="-390" y="5" width="390" height="390">
                        <Transform target="x" value="-390 + (((([UTC_TIMESTAMP] / 1000.0) * 14.5) + 450) % 900)" />
                        <Transform target="alpha" value="235" />
                        <Image resource="cloud_pair" />
                    </PartImage>
                    <PartImage x="-380" y="-10" width="380" height="380">
                        <Transform target="x" value="-380 + (((([UTC_TIMESTAMP] / 1000.0) * 16.0) + 600) % 900)" />
                        <Image resource="cloud_day" />
                    </PartImage>
                    <PartImage x="-370" y="25" width="370" height="370">
                        <Transform target="x" value="-370 + (((([UTC_TIMESTAMP] / 1000.0) * 17.5) + 750) % 900)" />
                        <Transform target="alpha" value="240" />
                        <Image resource="cloud_trio" />
                    </PartImage>
                </Compare>

                <!-- LLUVIA: 5 capas continuas de nubes densas (oscuras + grises) -->
                <Compare expression="is_rainy_clouds">
                    <PartImage x="-420" y="-55" width="420" height="420">
                        <Transform target="x" value="-420 + ((([UTC_TIMESTAMP] / 1000.0) * 11.0) % 900)" />
                        <Image resource="cloud_storm_pair" />
                    </PartImage>
                    <PartImage x="-410" y="-35" width="410" height="410">
                        <Transform target="x" value="-410 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 180) % 900)" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                    <PartImage x="-400" y="-20" width="400" height="400">
                        <Transform target="x" value="-400 + (((([UTC_TIMESTAMP] / 1000.0) * 15.0) + 360) % 900)" />
                        <Transform target="alpha" value="215" />
                        <Image resource="cloud_trio" />
                    </PartImage>
                    <PartImage x="-410" y="-40" width="410" height="410">
                        <Transform target="x" value="-410 + (((([UTC_TIMESTAMP] / 1000.0) * 14.0) + 540) % 900)" />
                        <Transform target="alpha" value="235" />
                        <Image resource="cloud_storm_pair" />
                    </PartImage>
                    <PartImage x="-390" y="-15" width="390" height="390">
                        <Transform target="x" value="-390 + (((([UTC_TIMESTAMP] / 1000.0) * 16.5) + 720) % 900)" />
                        <Transform target="alpha" value="220" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                </Compare>

                <!-- TORMENTA ELÉCTRICA: 5 capas escalonadas de nubes oscuras cubriendo SIEMPRE la zona superior -->
                <Compare expression="is_storm_clouds">
                    <PartImage x="-430" y="-75" width="430" height="430">
                        <Transform target="x" value="-430 + ((([UTC_TIMESTAMP] / 1000.0) * 13.0) % 900)" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                    <PartImage x="-430" y="-65" width="430" height="430">
                        <Transform target="x" value="-430 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 180) % 900)" />
                        <Image resource="cloud_storm_pair" />
                    </PartImage>
                    <PartImage x="-420" y="-55" width="420" height="420">
                        <Transform target="x" value="-420 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 360) % 900)" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                    <PartImage x="-430" y="-70" width="430" height="430">
                        <Transform target="x" value="-430 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 540) % 900)" />
                        <Image resource="cloud_storm_pair" />
                    </PartImage>
                    <PartImage x="-420" y="-50" width="420" height="420">
                        <Transform target="x" value="-420 + (((([UTC_TIMESTAMP] / 1000.0) * 13.0) + 720) % 900)" />
                        <Image resource="cloud_storm" />
                    </PartImage>
                </Compare>
            </Condition>

            <!-- 4. NIEVE LEJANA (SUAVE SIN SALTOS), NIEBLA DESCENDENTE Y VIENTO -->
            <Condition>
                <Expressions>
                    <Expression name="fx_has_snow"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 5 || [WEATHER.CONDITION] == 7 || [WEATHER.CONDITION] == 10 || [WEATHER.CONDITION] == 11)]]></Expression>
                    <Expression name="fx_has_fog"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 3 || [WEATHER.CONDITION] == 13)]]></Expression>
                    <Expression name="fx_has_wind"><![CDATA[[WEATHER.IS_AVAILABLE] && [WEATHER.CONDITION] == 15]]></Expression>
                </Expressions>
                <Compare expression="fx_has_snow">
                    <!-- Nieve lejana (seamless 450x900 cayendo suavemente con vaivén lateral) -->
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 42.0) % 450)" />
                        <Transform target="x" value="12 * sin([UTC_TIMESTAMP] / 1600.0)" />
                        <Image resource="fx_snow_slow" />
                    </PartImage>
                </Compare>
                <Compare expression="fx_has_fog">
                    <!-- Bruma/humo descendente suave de arriba hacia abajo (seamless 450x900) -->
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 34.0) % 450)" />
                        <Transform target="x" value="18 * sin([UTC_TIMESTAMP] / 2600.0)" />
                        <Transform target="alpha" value="185 + 45 * sin([UTC_TIMESTAMP] / 2800.0)" />
                        <Image resource="fx_fog_descend" />
                    </PartImage>
                </Compare>
                <Compare expression="fx_has_wind">
                    <PartImage x="-60" y="70" width="570" height="190">
                        <Transform target="x" value="-60 + ((([UTC_TIMESTAMP] / 1000.0) * 55.0) % 60)" />
                        <Image resource="fx_wind_streaks" />
                    </PartImage>
                </Compare>
            </Condition>
        </Group>

        <!-- =================================================================
             CAPA 5: INTERFAZ HUD (HORA, FECHA COMPLETA, BATERÍA, TEMPERATURA)
             Ubicada DEBAJO de la lluvia, nieve cercana, niebla baja y empañado.
             ================================================================= -->

        <!-- 5A. BATERÍA -->
        <BooleanConfiguration id="show_battery">
            <BooleanOption id="TRUE">
                <Group name="hud_battery" x="155" y="18" width="140" height="28">
                    <Variant mode="AMBIENT" target="alpha" value="130" />
                    <PartDraw x="0" y="0" width="140" height="28">
                        <RoundRectangle x="0" y="0" width="140" height="28" cornerRadiusX="14" cornerRadiusY="14">
                            <Fill color="#88000000" />
                        </RoundRectangle>
                    </PartDraw>
                    <PartText x="0" y="2" width="140" height="24">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFFFFFFF">
                                <Template>⚡ %s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- 5B. HORA DIGITAL -->
        <BooleanConfiguration id="show_time">
            <BooleanOption id="TRUE">
                <DigitalClock x="45" y="246" width="360" height="96">
                    <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" x="0" y="0" width="360" height="96" align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="82" weight="EXTRA_BOLD" color="#FFFFFFFF" />
                    </TimeText>
                </DigitalClock>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- Línea divisoria -->
        <PartDraw x="72" y="348" width="306" height="2">
            <Variant mode="AMBIENT" target="alpha" value="120" />
            <Rectangle x="0" y="0" width="306" height="2">
                <Fill color="#AAFFFFFF" />
            </Rectangle>
        </PartDraw>

        <!-- 5C. FECHA COMPLETA -->
        <BooleanConfiguration id="show_date">
            <BooleanOption id="TRUE">
                <PartText x="68" y="360" width="222" height="38">
                    <Variant mode="AMBIENT" target="alpha" value="175" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY_Z]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- 5D. TEMPERATURA -->
        <BooleanConfiguration id="show_temperature">
            <BooleanOption id="TRUE">
                <PartDraw x="296" y="354" width="2" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="120" />
                    <Rectangle x="0" y="0" width="2" height="42">
                        <Fill color="#AAFFFFFF" />
                    </Rectangle>
                </PartDraw>
                <PartText x="304" y="360" width="84" height="38">
                    <Variant mode="AMBIENT" target="alpha" value="175" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s°<Parameter expression="[WEATHER.IS_AVAILABLE] ? round([WEATHER.TEMPERATURE]) : '--'" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- =================================================================
             CAPA 6: EFECTOS SOBRE EL VIDRIO DEL RELOJ (POR ENCIMA DE LA HORA!)
             ================================================================= -->
        <Group name="watch_crystal_fx" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- 6A. LLUVIA EN TODA LA PANTALLA + GOTAS LIMPIAS RESBALANDO + EMPAÑADO SUTIL -->
            <Condition>
                <Expressions>
                    <Expression name="crystal_rain"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 4 || [WEATHER.CONDITION] == 6 || [WEATHER.CONDITION] == 9 || [WEATHER.CONDITION] == 12)]]></Expression>
                </Expressions>
                <Compare expression="crystal_rain">
                    <!-- Lluvia plano lejano (lenta) -->
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 260.0) % 450)" />
                        <Image resource="fx_rain_slow" />
                    </PartImage>
                    <!-- Lluvia plano cercano (rápida, por encima de la hora) -->
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 440.0) % 450)" />
                        <Image resource="fx_rain_fast" />
                    </PartImage>
                    <!-- Gotas limpias resbalando lentamente por el cristal (sin líneas arriba) -->
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 22.0) % 450)" />
                        <Image resource="fx_glass_drops_slide" />
                    </PartImage>
                    <!-- Cristal empañado sutil que respira sin blanquear demasiado la pantalla -->
                    <BooleanConfiguration id="show_glass_fog">
                        <BooleanOption id="TRUE">
                            <PartImage x="0" y="0" width="450" height="450">
                                <Transform target="alpha" value="75 + 75 * sin([UTC_TIMESTAMP] / 3500.0)" />
                                <Image resource="fx_glass_fog" />
                            </PartImage>
                        </BooleanOption>
                    </BooleanConfiguration>
                </Compare>
            </Condition>

            <!-- 6B. NIEVE CERCANA (CAYENDO SUAVEMENTE POR ENCIMA DE LA HORA SIN SALTOS) -->
            <Condition>
                <Expressions>
                    <Expression name="crystal_snow"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 5 || [WEATHER.CONDITION] == 7 || [WEATHER.CONDITION] == 10 || [WEATHER.CONDITION] == 11)]]></Expression>
                </Expressions>
                <Compare expression="crystal_snow">
                    <PartImage x="0" y="-450" width="450" height="900">
                        <Transform target="y" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 78.0) % 450)" />
                        <Transform target="x" value="-14 * sin([UTC_TIMESTAMP] / 1200.0)" />
                        <Image resource="fx_snow_fast" />
                    </PartImage>
                </Compare>
            </Condition>

            <!-- 6C. NIEBLA / HUMO RÁPIDO PASANDO POR LA PARTE BAJA DEL RELOJ -->
            <Condition>
                <Expressions>
                    <Expression name="crystal_fog"><![CDATA[[WEATHER.IS_AVAILABLE] && ([WEATHER.CONDITION] == 3 || [WEATHER.CONDITION] == 13)]]></Expression>
                </Expressions>
                <Compare expression="crystal_fog">
                    <!-- Velo de humo bajo pasando rápido de izquierda a derecha -->
                    <PartImage x="-450" y="195" width="900" height="260">
                        <Transform target="x" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 80.0) % 450)" />
                        <Transform target="alpha" value="185 + 45 * sin([UTC_TIMESTAMP] / 2100.0)" />
                        <Image resource="fx_fog_low_fast" />
                    </PartImage>
                    <!-- Segunda ráfaga de humo aún más rápida pegada al borde inferior -->
                    <PartImage x="-450" y="235" width="900" height="220">
                        <Transform target="x" value="-450 + ((([UTC_TIMESTAMP] / 1000.0) * 125.0) % 450)" />
                        <Transform target="alpha" value="195 + 50 * cos([UTC_TIMESTAMP] / 1700.0)" />
                        <Image resource="fx_fog_low_fast_b" />
                    </PartImage>
                    <!-- Ligera bruma empañada sobre el vidrio -->
                    <BooleanConfiguration id="show_glass_fog">
                        <BooleanOption id="TRUE">
                            <PartImage x="0" y="0" width="450" height="450">
                                <Transform target="alpha" value="60 + 55 * sin([UTC_TIMESTAMP] / 3200.0)" />
                                <Image resource="fx_glass_fog" />
                            </PartImage>
                        </BooleanOption>
                    </BooleanConfiguration>
                </Compare>
            </Condition>

            <!-- 6D. DESTELLO / REFLEJO DEL SOL SOBRE EL CRISTAL DEL RELOJ -->
            <Condition>
                <Expressions>
                    <Expression name="crystal_sun_glare"><![CDATA[[WEATHER.IS_AVAILABLE] && [WEATHER.IS_DAY] && ([WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8 || [WEATHER.CONDITION] == 14)]]></Expression>
                </Expressions>
                <Compare expression="crystal_sun_glare">
                    <PartImage x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
                        <Transform target="alpha" value="95 + 65 * sin([UTC_TIMESTAMP] / 1900.0)" />
                        <Transform target="angle" value="5 * sin([UTC_TIMESTAMP] / 3000.0)" />
                        <Image resource="fx_sun_glass_flare" />
                    </PartImage>
                </Compare>
            </Condition>
        </Group>

    </Scene>
</WatchFace>
